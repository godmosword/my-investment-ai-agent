# ============================================================
# Q-Silicon 日報 Pipeline — 環境變數範本 (.env.example)
# 請將此檔複製並重新命名為 .env，填入實際金鑰後存檔
# 絕對不要將填有真實金鑰的 .env 提交到版本控制系統 (Git)！
# ============================================================

# ---------- 必要：LLM API（缺一則啟動時報錯）----------
XAI_API_KEY=your_xai_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# ---------- 資料/搜尋 API（工具會用到，缺則該工具回傳 DATA_MISSING）----------
COINGLASS_API_KEY=your_coinglass_api_key_here
CRYPTOPANIC_API_KEY=your_cryptopanic_api_key_here
APIFY_API_TOKEN=your_apify_api_token_here

# ---------- Telegram 推送（選填，不填則不發送）----------
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ---------- GCP / BigQuery（選填，預設專案名見下）----------
GCP_PROJECT_ID=my-investment-ai-agent

# ---------- 選填：除錯與系統行為 ----------
# 移除註解符號 (#) 即可啟用覆寫
# LOG_LEVEL=INFO
# DEBUG=0
# CREW_VERBOSE=0
# SKIP_TELEGRAM=0
# SKIP_BIGQUERY=0
# MAX_REPORT_RETRIES=2
# MAX_503_RETRIES=3
# BACKOFF_BASE_SEC=30