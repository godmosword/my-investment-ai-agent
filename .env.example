# ============================================================
# Q-Silicon 日報 Pipeline — 環境變數範本 (.env.example)
# 請將此檔複製並重新命名為 .env，填入實際金鑰後存檔
# 絕對不要將填有真實金鑰的 .env 提交到版本控制系統 (Git)！
# ============================================================

# ---------- 🧠 第一層：LLM 大腦引擎（必須，缺一不可）----------
XAI_API_KEY=your_xai_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ---------- 📰 第二層：新聞與社群雷達（強烈建議，避免眼盲）----------
APIFY_API_TOKEN=your_apify_api_token_here
# X/Twitter 推文情緒 (官方 API v2 或 RapidAPI twitter154 備援擇一)
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here
RAPIDAPI_KEY=your_rapidapi_key_here
NEWSAPI_KEY=your_newsapi_key_here
GNEWS_API_KEY=your_gnews_api_key_here

# ---------- 📊 第三層：機構級量化數據（進階，可留空）----------
# CoinGlass v4：Header CG-API-KEY；401 + Upgrade plan＝方案不含端點（見 README）
COINGLASS_API_KEY=your_coinglass_api_key_here
CRYPTOPANIC_API_KEY=your_cryptopanic_api_key_here
FRED_API_KEY=your_fred_api_key_here
FMP_API_KEY=your_fmp_api_key_here
CRYPTOQUANT_API_KEY=your_cryptoquant_api_key_here
# financialdatasets.ai — AI 段美股財報摘要（選填；無 key 則 [DATA_MISSING:financial_datasets]）
FINANCIAL_DATASETS_API_KEY=your_financial_datasets_api_key_here
# FINANCIAL_DATASETS_API_BASE=https://api.financialdatasets.ai
# Polygon.io — options snapshots/Greeks/trades（options flow + GEX 管線；需付費 Options 方案）
# Starter 拿 Greeks→GEX；Advanced 拿 trades→tick sweep/block。無 key 或方案不足則 [DATA_MISSING:polygon_options_*]
POLYGON_API_KEY=your_polygon_api_key_here

# ---------- 🚀 系統與通知部署（選填）----------
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
GCP_PROJECT_ID=my-investment-ai-agent


# ---------- 資產清單 / 探測（選填）----------
# ASSETS_CONFIG_PATH=  # 覆寫 crypto 清單 JSON，預設 assets_config.json
# VERIFY_API_KEYS=1    # 啟動後輕量探測 NewsAPI/Apify；日誌見 API key inventory

# ---------- 🛠️ 選填：除錯與系統行為 ----------
# 移除註解符號 (#) 即可啟用覆寫
# LOG_LEVEL=INFO
# DEBUG=0
# CREW_VERBOSE=0
# SKIP_TELEGRAM=0
# SKIP_BIGQUERY=0
# MAX_REPORT_RETRIES=2
# MAX_503_RETRIES=3
# BACKOFF_BASE_SEC=30
# NEWSAPI_DAILY_CALL_LIMIT=120
# GNEWS_DAILY_CALL_LIMIT=120
# APIFY_DAILY_CALL_LIMIT=30
# DISABLE_SOURCE_HEALTH_BQ=1
