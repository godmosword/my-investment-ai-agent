{% macro telegram_ai_section(crypto, ai) %}
────────────
🤖 AI 市場
{% if ai.macro_bridge_lines %}
<i>宏觀連結：</i>
{% for line in ai.macro_bridge_lines %}
· {{ line|tg_soft_wrap_mobile }}
{% endfor %}
{% endif %}

<b>🤖 區塊①</b>【AI 數據儀表板】
{% for row in ai.dashboard %}
{% if row.is_section_header %}
· <b>{{ row.label|tg_escape }}</b>
{% else %}
· <b>{{ row.label|tg_escape }}</b> <code>{{ row.value|tg_escape }}</code>
{% endif %}
{% endfor %}
{% if ai.earnings_event_lines %}

<b>【財報雷達｜未來 7 天】</b>
{% for line in ai.earnings_event_lines %}
· {{ line|tg_escape }}
{% endfor %}
{% endif %}

<b>區塊②</b>【AI 產業新聞】
{% for n in ai.news %}
〔新聞 {{ n.index }}〕{{ n.timestamp_line|tg_escape }}
<b>{{ n.title|tg_escape }}</b>（{{ n.source_and_nature|tg_escape }}）
<blockquote>{{ n.summary|tg_escape }}</blockquote>
<i>投資解讀</i>：{{ n.investment_takeaway|tg_escape }}
<i>💎主編共識</i>：{{ n.editor_consensus|tg_escape }}
{% if n.pricing_note %}
<i>市場定價</i>：<code>{{ n.pricing_note|tg_escape }}</code>
{% endif %}

{% endfor %}
{% if ai.x_highlights %}
<b>區塊②b</b> 主題式觀點摘要（非即時推文）
{% for x in ai.x_highlights %}
· {{ x|tg_escape }}
{% endfor %}
{% endif %}

<b>區塊③</b>【產業鏈呢喃】
{% if ai.chatter %}
{% for c in ai.chatter %}
· {{ c.text|tg_soft_wrap_mobile }}
{% endfor %}
{% else %}
· 傳聞可信度：B（未確認）｜主流媒體二次驗證：否
{% endif %}

<b>區塊④</b>【AI 產業鏈精準操作 (US Equities)】
{% if ai.ai_block4_recommendation_line %}
{{ ai.ai_block4_recommendation_line }}
{% endif %}
本日選擇理由：{{ ai.pick_reason|tg_soft_wrap_mobile }}
訊號衝突摘要：{{ ai.signal_conflict_summary|tg_soft_wrap_mobile }}
{% if ai.us_equity_allocation_note %}
· <b>美股部位框</b>：{{ ai.us_equity_allocation_note|tg_escape }}
{% endif %}
{% if ai.trade_legs %}
{% for leg in ai.trade_legs %}
{% if not loop.first %}

{% endif %}
· <b>${{ (leg.asset|string|strip_usd)|tg_escape }} ({{ leg.direction }})</b>｜現價：<code>${{ (leg.current_price|string|strip_usd)|tg_escape }}</code>｜信心：{% for _ in range(leg.star_rating|int) %}⭐️{% endfor %}

· <b>計畫</b>：進場 <code>{{ (leg.entry|string|strip_usd)|tg_escape }}</code> 🎯 目標 <code>{{ (leg.target|string|strip_usd)|tg_escape }}</code> 🛑 停損 <code>{{ (leg.stop|string|strip_usd)|tg_escape }}</code>（建議倉位 {{ (leg.position_pct|string|strip_usd)|tg_escape }}）

· <b>執行</b>：{{ (leg.trigger|default('', true)|string|strip_usd)|replace('。。', '。')|tg_escape }}
{% if leg.invalidation %}
· <b>失效</b>：{{ leg.invalidation|clean_invalidation|tg_escape }}
{% endif %}

· <b>敘事</b>：{{ leg.narrative|tg_escape }}
{% if leg.liquidity_execution_note %}
· <b>流動性／執行</b>：{{ leg.liquidity_execution_note|tg_escape }}
{% endif %}

{% endfor %}
{% else %}
· <b>觀望模式</b>：資料不足觀望，暫不提供股票進出場價格。
· 風險預算：依 <code>{{ crypto.market.regime }}</code> 模式執行防守配置，避免情緒性追價。
· 重新進場條件：需補齊產業催化、成交量與多時框確認後再發布可執行建議。
{% endif %}

────────────
{% endmacro %}
