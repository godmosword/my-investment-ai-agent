{% macro telegram_institutional_view(crypto, institutional_disclaimer_html) %}
{% if institutional_disclaimer_html %}
{{ institutional_disclaimer_html }}
{% endif %}
{% if crypto.investment_thesis_one_liner or crypto.portfolio_framing_summary or crypto.scenario_probability_notes or crypto.event_calendar_lines %}
<b>【機構速讀｜命題與情境】</b>
{% if crypto.investment_thesis_one_liner %}
<b>【投資命題】</b>
{{ crypto.investment_thesis_one_liner|tg_escape }}
{% endif %}
{% if crypto.thesis_supporting_points %}
<b>【支持論點】</b>
{% for line in crypto.thesis_supporting_points %}
· {{ line|tg_escape }}
{% endfor %}
{% endif %}
{% if crypto.thesis_contrary_points %}
<b>【反駁論點】</b>
{% for line in crypto.thesis_contrary_points %}
· {{ line|tg_escape }}
{% endfor %}
{% endif %}
{% if crypto.key_assumptions_lines %}
<b>【關鍵假設】</b>
{% for line in crypto.key_assumptions_lines %}
· {{ line|tg_escape }}
{% endfor %}
{% endif %}
{% if crypto.narrative_invalidation_summary %}
<b>【敘事失效】</b>
{{ crypto.narrative_invalidation_summary|tg_escape }}
{% endif %}
{% if crypto.portfolio_framing_summary %}
<b>【組合與曝險框架】</b>
{{ crypto.portfolio_framing_summary|tg_escape }}
{% endif %}
{% if crypto.scenario_probability_notes %}
<b>【三情境機率】</b>
{% for line in crypto.scenario_probability_notes.split('\n') %}
{% if line.strip() %}
· {{ line.strip()|tg_escape }}
{% endif %}
{% endfor %}
{% endif %}
{% if crypto.crypto_cycle_valuation_notes %}
<b>【加密週期與估值錨】</b>
{{ crypto.crypto_cycle_valuation_notes|tg_escape }}
{% endif %}
{% if crypto.equity_valuation_framing %}
<b>【美股估值與修正框架】</b>
{{ crypto.equity_valuation_framing|tg_escape }}
{% endif %}
{% if crypto.event_calendar_lines %}
<b>【近端事件日曆】</b>
{% for line in crypto.event_calendar_lines %}
· {{ line|tg_escape }}
{% endfor %}
{% endif %}
────────────
{% endif %}
{% endmacro %}
