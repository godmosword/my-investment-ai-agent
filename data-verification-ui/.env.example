# data-verification-ui — Vite 前端環境變數範例
# 複製為 .env.local，或由 CI／靜態託管 inject build-args（勿提交含真金鑰之 .env）

# ---------- Production / staging 建置 ----------
# 必填（正式站）：後端 FastAPI 公開基底 URL（含 https://；建議無尾隨 /）
# Production build 若未設定，App 顯示頂部提示（VITE_E2E=1 時略過）
# VITE_API_URL=https://api.example.com

# 選填：建置時預設 X-Q-Silicon-Key（production 建議勿寫死；以 /api-key + localStorage 為主）
# VITE_QSILICON_KEY=

# ---------- SSE（War Room；須與後端 TERMINAL_SSE_ENABLED 對齊）----------
# VITE_SSE_ENABLED=0
# VITE_SSE_STREAM_KEY=

# ---------- Web Push（見 docs/PWA_WEB_PUSH.md）----------
# VITE_WEB_PUSH_REGISTER=0
# VITE_WEB_PUSH_VAPID_PUBLIC_KEY=
# VITE_PUSH_SUBSCRIBE_REPORT_DATE=
# VITE_PUSH_SUBSCRIBE_BLOCK_ID=

# ---------- 結構化日報 / Archive ----------
# VITE_STRUCTURED_REPORT=0

# ---------- Insights Terminal 輪詢（useApi.js）----------
# VITE_TERMINAL_POLL_MS=
# VITE_TERMINAL_QUERY_COALESCE=

# ---------- 僅 E2E／CI（勿用於 production 行為假設）----------
# VITE_E2E=0

# ---------- 文件／設計稿提及（目前 bundle 未讀取；預留）----------
# VITE_GLASSBOX_MOCK=0
